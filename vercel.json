{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/ads.txt",
      "dest": "/api/index.ts?path=ads.txt"
    },
    {
      "src": "/sitemap-main.xml",
      "dest": "/api/index.ts?path=sitemap-main.xml"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/index.ts?path=sitemap.xml"
    },
    {
      "src": "/sitemap-terms.xml",
      "dest": "/api/index.ts?path=sitemap-terms.xml"
    },
    {
      "src": "/sitemap-index.xml",
      "dest": "/api/index.ts?path=sitemap-index.xml"
    },
    {
      "src": "/download/(.*)",
      "dest": "/api/index.ts?path=download/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?path=$1"
    },
    {
      "src": "/generate-article",
      "dest": "/api/index.ts?path=generate-article"
    },
    {
      "src": "/search-unsplash",
      "dest": "/api/index.ts?path=search-unsplash"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
